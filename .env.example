# ============================================================
# 环境变量模板 — 复制为 .env 并填写实际值后使用
# 请勿将真实 .env 文件上传到公开仓库
# ============================================================

# WandB API Key（用于训练日志追踪）
export WANDB_API_KEY="your_wandb_api_key_here"

# 模型路径
export MODEL_PATH="/path/to/Qwen3-8B"

# 数据集根目录
export DATASET_ROOT_DIR="/path/to/dataset"

# DeepSeek API Key（用于标签审计，如不需要可不填）
export DEEPSEEK_API_KEY="your_api_key_here"

# GPU 配置
export CUDA_VISIBLE_DEVICES=0,1,2
export NUM_GPUS=3

# 训练超参（可选覆盖）
export TRAIN_BATCH_SIZE=504
export MAX_PROMPT_LENGTH=1500
export MAX_RESPONSE_LENGTH=2048
export LR=1e-6
export KL_COEF=0.0005
export ROLLOUT_N=4
export TEMPERATURE=0.8
export PPO_EPOCHS=4
export SAVE_FREQ=30
export TEST_FREQ=30
